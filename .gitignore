# Cross-cutting ignores. Each part has its own .gitignore for its build output.

# secrets: never commit (canonical copies live in /etc/haku/ on nserver)
.env
.env.*
!.env.example
*.env
secrets.json

# The house's specifics: kept on the workstation, never committed (see README § Private configuration)
PRIVATE.md
docs/private/
config/live/
ha/secrets.private.yaml

# Claude Code local settings
.claude/settings.local.json

# python caches (sidecar/ has its own ignores; stream/tests too)
__pycache__/
.pytest_cache/

# editors / OS
.idea/
.vscode/launch.json
*.swp
.DS_Store
Thumbs.db

# superpowers executor ledgers (scratch)
.superpowers/
