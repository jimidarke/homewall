# Roku fleet settings for `npm run deploy`, `scripts/fleet-deploy.sh` and
# `tools/baseline.sh`. Real copy: ~/.config/haku/fleet.env on the workstation (mode 600)
# and /etc/haku/fleet.env on nserver (0640 root:media). Never commit values.

# Dev-mode (sideload) passwords: ROKU_PW_OFFICE for the Rokus in ROKU_OFFICE_PW_IPS,
# ROKU_PW_FLEET for every other one.
ROKU_PW_FLEET=
ROKU_PW_OFFICE=

# Space-separated LAN addresses.
ROKU_FLEET="192.0.2.51 192.0.2.52 192.0.2.53 192.0.2.54 192.0.2.55 192.0.2.56"
ROKU_OFFICE_PW_IPS="192.0.2.55 192.0.2.56"

# Hosts tools/baseline.sh measures: Home Assistant (mserver) and the HAku media host (nserver).
HA_HOST=192.0.2.10
HAKU_HOST=192.0.2.20

# Optional: live targets for `npm run test:contract` (else it falls back to the fixtures).
# HAKU_DISCOVERY_URL=http://192.0.2.20:1985/discovery.json
# HAKU_SIDECAR_URL=http://192.0.2.20:1986
