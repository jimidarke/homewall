# Roku dev-mode passwords for `npm run deploy` / `scripts/fleet-deploy.sh`.
# Real copy: ~/.config/haku/fleet.env on the MiniPC (mode 600) and
# /etc/haku/fleet.env on nserver (0640 root:media). Never commit values.
ROKU_PW_FLEET=
# dev-mode password on living .51, kids .52, master .53, den .54
ROKU_PW_OFFICE=
# dev-mode password on office .55 and dad .56
