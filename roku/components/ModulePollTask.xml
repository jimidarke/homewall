<?xml version="1.0" encoding="utf-8" ?>
<!--
  ModulePollTask — one-shot GET /api/config (when fetchConfig) + /api/state off the
  render thread. MainScene sets hubBase from discovery and `layout` (HK_LAYOUT), fires
  control="RUN" on a Timer, observes `snapshot` and `config`. `activeLayout` is the
  layout the sidecar actually served: "" after falling back to the default view.
-->
<component name="ModulePollTask" extends="Task">
    <interface>
        <field id="hubBase" type="string" value="" />
        <field id="layout" type="string" value="" />
        <field id="activeLayout" type="string" value="" />
        <field id="fetchConfig" type="boolean" value="false" />
        <field id="config" type="assocarray" alwaysNotify="true" />
        <field id="snapshot" type="assocarray" alwaysNotify="true" />
        <field id="ok" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="ModulePollTask.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/Glyphs.brs" />
    <script type="text/brightscript" uri="pkg:/source/Http.brs" />
    <script type="text/brightscript" uri="pkg:/source/Api.brs" />
</component>
