<?xml version="1.0" encoding="utf-8" ?>
<!--
  ModuleTile — one glass card on the home wall (the tablet's v3 GlassCard
  without the frost). Read-only: no focus, no drill.

  Layers, back to front: the night-tinted rounded fill (9-patch), the lit glow, the
  content (title, glyph chip, and a body component picked by hkCardKind: ValueBody,
  DoorsBody, LaundryBody, AgendaBody or ForecastBody; or CameraBody, the live feed
  under the rim), the lit rim, and the resting edge with
  its top highlight. Lit (active or alert) colours the chip, glyph, rim and glow in
  the glyph's accent, or coral on alert; stale or offline cards stay quiet.
-->
<component name="ModuleTile" extends="Group">
    <interface>
        <field id="descriptor" type="assocarray" onChange="onDescriptor" />
        <field id="values" type="assocarray" onChange="onValues" />
        <field id="fonts" type="assocarray" />
        <field id="tileW" type="integer" value="286" />
        <field id="tileH" type="integer" value="292" />
        <!-- in: the whole wall is offline (dims content, quiets every card) -->
        <field id="offline" type="boolean" value="false" onChange="applyState" />
        <!-- in: an HA focusModule= takeover asked to point at this card -->
        <field id="attention" type="boolean" value="false" alwaysNotify="true" onChange="onAttention" />
        <!-- in, passed to the body: the sidecar base, discovery's streams, and whether a
             camera body may hold the decoder -->
        <field id="hubBase" type="string" value="" onChange="passDown" />
        <field id="streams" type="assocarray" onChange="passDown" />
        <field id="camActive" type="boolean" value="false" onChange="passDown" />
        <field id="camOverride" type="string" value="" onChange="passDown" />
        <!-- out: this card shows no current reading (the header's "degraded") -->
        <field id="stale" type="boolean" value="true" />
    </interface>
    <script type="text/brightscript" uri="ModuleTile.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/Glyphs.brs" />
    <script type="text/brightscript" uri="pkg:/source/Ui.brs" />
    <children>
        <Poster id="fill" uri="pkg:/images/glass/fill.9.png" />
        <Poster id="glow" uri="pkg:/images/glass/glow.png" opacity="0" />
        <Group id="content">
            <Label id="title" />
            <Poster id="chip" uri="pkg:/images/glass/chip.png" width="60" height="60" opacity="0" />
            <Poster id="glyph" width="40" height="40" />
            <Group id="body" />
        </Group>
        <Poster id="rim" uri="pkg:/images/glass/rim.9.png" opacity="0" />
        <Poster id="edge" uri="pkg:/images/glass/edge.9.png" />
        <Animation id="fade" duration="0.6" easeFunction="linear">
            <FloatFieldInterpolator id="rimFade" key="[0.0, 1.0]" fieldToInterp="rim.opacity" />
            <FloatFieldInterpolator id="glowFade" key="[0.0, 1.0]" fieldToInterp="glow.opacity" />
            <FloatFieldInterpolator id="chipFade" key="[0.0, 1.0]" fieldToInterp="chip.opacity" />
        </Animation>
        <Timer id="attentionTimer" repeat="false" duration="8" />
    </children>
</component>
