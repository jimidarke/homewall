<?xml version="1.0" encoding="utf-8" ?>
<!--
  MainScene — state router. Owns:
    - DiscoveryTask (SSDP + JSON fetch)
    - InputPumpTask (ECP /input fan-out)
    - HomeGroup     (default route: the read-only glass wall)
    - LiveGroup     (HA camera takeovers)
    - GridGroup     (toggled on long-press OK from live)
    - OverlayLayer  (door / weather / sensor / pip / text)
    - Toast         (top-centre legacy notifier — kept above overlays)

  Inputs:
    args  : assoc array of deep-link params, set by main.brs
-->
<component name="MainScene" extends="Scene">
    <interface>
        <field id="args" type="assocarray" onChange="onArgs" />
    </interface>

    <script type="text/brightscript" uri="MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/Glyphs.brs" />
    <script type="text/brightscript" uri="pkg:/source/Api.brs" />

    <children>
        <!-- Black base behind the rotating photo (shows before the first image
             loads and while it cross-fades). -->
        <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />

        <!-- Hidden keep-awake decoder: a tiny silent looping clip that keeps the
             OS screensaver from taking over on home/module/diag (Roku has no API
             to disable the screensaver). Stopped whenever the live/mosaic decoder
             runs, honouring the single-H.264-decoder budget. -->
        <Video id="keepAwake" width="16" height="16" translation="[0, 0]"
               opacity="0.004" mute="true" />

        <!-- Rotating photo backdrop under a vertical night scrim (darker behind the
             header), so the glass cards and the free-floating clock stay legible. -->
        <BackgroundGallery id="bgGallery" />
        <Poster id="bgDim" width="1920" height="1080" uri="pkg:/images/glass/scrim.png" />

        <HomeGroup id="home" />
        <LiveGroup id="live" visible="false" />
        <GridGroup id="grid" visible="false" />
        <ModuleScreen id="moduleScreen" visible="false" />
        <DiagScreen id="diag" visible="false" />

        <OverlayLayer id="overlays" />
        <Toast id="toast" />

        <DiscoveryTask id="discover" />
        <InputPumpTask id="inputPump" />
        <ModulePollTask id="modules" />
        <BackgroundListTask id="bgList" />
        <DiagHealthTask id="diagHealth" />

        <Timer id="rediscoverTimer" repeat="false" duration="5" />
        <Timer id="stateTimer" repeat="true" duration="10" />
        <Timer id="idleTimer" repeat="false" duration="300" />
        <Timer id="returnHomeTimer" repeat="false" duration="60" />
        <!-- clears an HA homeCam= override whose revert never arrived -->
        <Timer id="homeCamTimer" repeat="false" duration="900" />
        <!-- Re-reads the shared photo list, so photos added to the folder show up
             without a relaunch. -->
        <Timer id="bgListTimer" repeat="true" duration="600" />
        <!-- Re-asserts the keep-awake video if its manual loop ever drops it, so
             the screensaver can't slip back in on home/module/diag. -->
        <Timer id="keepAwakeWatchdog" repeat="true" duration="30" />

        <Label id="debugLabel"
               translation="[40, 1020]"
               color="0xFAF6EEAA"
               font="font:SmallestSystemFont"
               visible="false"
               text="" />
    </children>
</component>
