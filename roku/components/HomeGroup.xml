<?xml version="1.0" encoding="utf-8" ?>
<!--
  HomeGroup — the HAku home wall: a read-only pane of glass ModuleTile cards
  built from /api/config?layout=roku, fed values from /api/state. No focus and no
  key handling: keys bubble to MainScene (options opens diag, Back exits).

  The header is the tablet's: clock and date on the left, the data-freshness dot and
  word on the right (hkHeaderStatus). While the data is offline the cards dim and a
  banner says since when. Everything shifts +-2 px every 10 minutes (hkBurnIn).
-->
<component name="HomeGroup" extends="Group">
    <interface>
        <field id="config" type="assocarray" onChange="onConfig" />
        <field id="state" type="assocarray" onChange="onState" />
        <!-- epoch seconds of the last good /api/state (0 = never) -->
        <field id="lastOk" type="integer" value="0" onChange="updateStatus" />
        <!-- a state fetch has finished, good or not (until then: "connecting") -->
        <field id="fetched" type="boolean" value="false" onChange="updateStatus" />
        <!-- the sidecar base (the forecast chart image) and discovery's streams -->
        <field id="hubBase" type="string" value="" onChange="onHubBase" />
        <field id="streams" type="assocarray" onChange="onStreams" />
        <!-- in: the camera card may hold the decoder (MainScene, while home shows) -->
        <field id="camActive" type="boolean" value="false" onChange="onCamActive" />
        <!-- out: there is a camera card with a playable stream -->
        <field id="hasCam" type="boolean" value="false" />
        <!-- module id an HA focusModule= takeover points at -->
        <field id="attention" type="string" alwaysNotify="true" onChange="onAttention" />
    </interface>
    <script type="text/brightscript" uri="HomeGroup.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/Glyphs.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
    <script type="text/brightscript" uri="pkg:/source/Ui.brs" />
    <children>
        <Group id="shift">
            <Label id="clock" translation="[72, 34]" height="72" vertAlign="bottom" color="0xFAF6EEFF" />
            <Label id="date" height="72" vertAlign="bottom" color="0xFAF6EEC7" />
            <Poster id="statusDot" uri="pkg:/images/glass/dot.png" width="14" height="14" />
            <Label id="status" height="72" vertAlign="center" color="0xFAF6EEC7" />
            <Group id="tiles" />
            <Group id="banner" visible="false">
                <Poster id="bannerFill" uri="pkg:/images/glass/fill.9.png" />
                <Label id="bannerText" vertAlign="center" color="0xFAF6EEFF" />
            </Group>
            <Label id="empty" translation="[60, 520]" width="1800" horizAlign="center"
                   color="0xFAF6EEC7" text="Waiting for HAku hub…" />
        </Group>
        <Timer id="clockTimer" repeat="false" />
        <Timer id="statusTimer" repeat="true" duration="5" />
    </children>
</component>
