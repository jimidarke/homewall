<?xml version="1.0" encoding="utf-8" ?>
<!--
  DiagHealthTask — fetch the sidecar's /api/health off the render thread for the
  diagnostic screen. Publishes the parsed payload (plus a `reachable` flag) so the
  render thread never blocks on the transfer.
-->
<component name="DiagHealthTask" extends="Task">
    <interface>
        <field id="hubBase" type="string" value="" />
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="DiagHealthTask.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/Api.brs" />
    <script type="text/brightscript" uri="pkg:/source/Http.brs" />
</component>
