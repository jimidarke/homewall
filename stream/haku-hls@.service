[Unit]
Description=HAku HLS sidecar (3 × 2s window) — %i
Documentation=man:ffmpeg(1) https://github.com/AlexxIT/go2rtc/issues/1699
After=go2rtc.service network-online.target
Requires=go2rtc.service

[Service]
Type=simple
User=media
Group=media

# All instances write to the same /run/haku-hls/ tmpfs. Each ffmpeg
# instance prefixes its segments with %i so they don't collide:
#   /run/haku-hls/<cam>.m3u8
#   /run/haku-hls/<cam>_seg_NNNNN.ts
# RuntimeDirectoryPreserve keeps the dir alive when one instance stops
# so peers don't lose their segments.
RuntimeDirectory=haku-hls
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Why this exists: go2rtc's built-in HLS publishes only ~2 segments × 0.5s
# = ~1s of buffer, which underflows the Roku player on any 500ms+ network
# blip (AlexxIT/go2rtc#1699). This sidecar pulls the already-encoded H.264
# stream from go2rtc's RTSP output and remuxes it as proper HLS. No re-encode (CPU≈0).
#
# Window = latency: a Roku plays from the oldest segment in the playlist, so
# 3 × 2s segments puts it ~5s behind live (6 × 2s was ~12s). Measured on all five
# Rokus 2026-10-14: 3 × 2s holds with no stalls; 3 × 1s made the Express restart
# its player and drift back. Segments only cut on keyframes, so a camera with a
# longer GOP gets longer segments (yard: ~4s). hls_delete_threshold keeps 4
# segments on disk after they leave the playlist, for a Roku that slips behind.
#
# %i is the systemd instance suffix — start with:
#   systemctl enable --now haku-hls@front haku-hls@yard ...
ExecStartPre=/bin/sh -c 'rm -f /run/haku-hls/%i.m3u8 /run/haku-hls/%i_seg_*.ts'
ExecStart=/usr/bin/ffmpeg \
  -hide_banner -loglevel warning \
  -fflags +genpts -avoid_negative_ts make_zero \
  -rtsp_transport tcp -i rtsp://127.0.0.1:8554/%i \
  -c copy -an \
  -f hls \
    -hls_time 2 \
    -hls_list_size 3 \
    -hls_delete_threshold 4 \
    -hls_flags delete_segments+omit_endlist+independent_segments \
    -hls_segment_type mpegts \
    -hls_segment_filename /run/haku-hls/%i_seg_%%05d.ts \
    /run/haku-hls/%i.m3u8

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
