[Unit]
Description=HAku HLS sidecar — mosaic, 3 × 2s window
Documentation=man:ffmpeg(1) https://github.com/AlexxIT/go2rtc/issues/1699
After=go2rtc.service network-online.target
Requires=go2rtc.service

[Service]
Type=simple
User=media
Group=media

# tmpfs for HLS segments — written every 2s, deleted as the window rolls.
RuntimeDirectory=haku-hls
RuntimeDirectoryMode=0755
# Shared with the haku-hls@ instances: without Preserve, this unit exiting deletes
# /run/haku-hls and every camera's segments. Upstreamed 2026-10-03 from the nserver
# drop-in haku-hls.service.d/10-preserve-runtime-dir.conf (added 2026-09-11).
RuntimeDirectoryPreserve=yes

# go2rtc can serve HLS itself, but its playlist holds about a second of media
# (AlexxIT/go2rtc#1699) and the Roku player runs dry on the smallest Wi-Fi hiccup.
# So this unit reads go2rtc's RTSP output and writes our own HLS with ffmpeg
# (-c copy: a remux, no re-encode, next to no CPU).
#
# Window = latency: a Roku plays from the oldest segment in the playlist, so
# 3 × 2s segments puts it ~5s behind live (6 × 2s was ~12s). Measured on all five
# Rokus 2026-10-14: 3 × 2s holds with no stalls; 3 × 1s made the Express restart
# its player and drift back. Segments only cut on keyframes, so a camera with a
# longer GOP gets longer segments (yard: ~4s). hls_delete_threshold keeps 4
# segments on disk after they leave the playlist, for a Roku that slips behind.
# Clear this unit's own stale playlist and segments (un-prefixed seg_NNNNN.ts) before
# starting, as the haku-hls@ template does for its %i-prefixed files.
ExecStartPre=/bin/sh -c 'rm -f /run/haku-hls/mosaic.m3u8 /run/haku-hls/seg_*.ts'
ExecStart=/usr/bin/ffmpeg \
  -hide_banner -loglevel warning \
  -fflags +genpts -avoid_negative_ts make_zero \
  -rtsp_transport tcp -i rtsp://127.0.0.1:8554/mosaic \
  -c copy -an \
  -f hls \
    -hls_time 2 \
    -hls_list_size 3 \
    -hls_delete_threshold 4 \
    -hls_flags delete_segments+omit_endlist+independent_segments \
    -hls_segment_type mpegts \
    -hls_segment_filename /run/haku-hls/seg_%%05d.ts \
    /run/haku-hls/mosaic.m3u8

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
