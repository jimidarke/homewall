{
  "version": 1,
  "site": "home",
  "timezone": "America/Edmonton",
  "grid": { "cols": 4, "rows": 2, "cellW": 432, "cellH": 440, "originX": 60, "originY": 160, "gap": 24 },
  "background": { "intervalMs": 20000, "enabled": true },
  "modules": [
    {
      "id": "weather",
      "kind": "weather",
      "title": "Weather",
      "icon": "wx",
      "tile": { "type": "value", "col": 0, "row": 0, "w": 1, "h": 1 },
      "drill": { "type": "chart", "card": "/api/card/weather_forecast.png" },
      "feedKey": "weather",
      "refreshMs": 30000,
      "entities": {
        "forecast": "weather.edmonton_forecast",
        "indoor": "weather.my_ecobee"
      }
    },
    {
      "id": "energy",
      "kind": "energy",
      "title": "Energy",
      "icon": "bolt",
      "tile": { "type": "value", "col": 1, "row": 0, "w": 1, "h": 1 },
      "drill": { "type": "value" },
      "feedKey": "energy",
      "refreshMs": 30000,
      "entities": {
        "power": "sensor.emporia_total_power",
        "daily_energy": "sensor.emporia_total_daily_energy_kwh",
        "cost": "sensor.electricity_daily_cost"
      }
    },
    {
      "id": "water",
      "kind": "water",
      "title": "Water",
      "icon": "drop",
      "tile": { "type": "value", "col": 0, "row": 1, "w": 1, "h": 1 },
      "drill": { "type": "value" },
      "feedKey": "water",
      "refreshMs": 30000,
      "maxFlowLpm": 10,
      "entities": {
        "hourly": "sensor.water_hourly_usage",
        "flow": "sensor.water_flow_lpm",
        "daily": "sensor.water_daily_usage",
        "monthly": "sensor.water_monthly_usage",
        "total": "sensor.water_meter_total"
      }
    },
    {
      "id": "cameras",
      "kind": "cameras",
      "title": "Cameras",
      "icon": "cam",
      "tile": { "type": "camera", "col": 2, "row": 0, "w": 1, "h": 1, "thumbCam": "mosaic" },
      "drill": { "type": "camera", "route": "live" },
      "feedKey": "cameras",
      "refreshMs": 10000,
      "streams": ["front", "yard", "side", "backyard", "mosaic"],
      "entities": {
        "motion": {
          "front": "binary_sensor.front_motion_occupancy",
          "backyard": "binary_sensor.backyard_motion_occupancy"
        }
      }
    },
    {
      "id": "timeline",
      "kind": "timeline",
      "title": "Recent Activity",
      "icon": "activity",
      "tile": { "type": "agenda", "col": 1, "row": 1, "w": 1, "h": 1, "rotate": false, "dropHeaders": true },
      "drill": { "type": "agenda" },
      "feedKey": "timeline",
      "refreshMs": 30000,
      "lookbackHours": 12,
      "coalesceWindowSec": 300,
      "entities": {
        "watch": [
          "binary_sensor.front_doorcontact_contact",
          "binary_sensor.back_doorcontact_contact",
          "binary_sensor.bathroom_door_contact",
          "binary_sensor.front_motion_occupancy",
          "binary_sensor.backyard_motion_occupancy",
          "binary_sensor.my_ecobee_occupancy",
          "binary_sensor.shed_motion_occupancy",
          "binary_sensor.water_in_tier_2",
          "person.jimi",
          "person.alex",
          "person.robin"
        ]
      }
    },
    {
      "id": "calendar",
      "kind": "calendar",
      "title": "Calendar",
      "icon": "cal",
      "tile": { "type": "agenda", "col": 2, "row": 1, "w": 1, "h": 1, "rotate": false },
      "drill": { "type": "agenda" },
      "feedKey": "calendar",
      "refreshMs": 60000,
      "lookaheadDays": 14,
      "entities": {
        "calendars": ["calendar.family"]
      }
    },
    {
      "id": "gas",
      "kind": "gas",
      "title": "Gas",
      "icon": "gas",
      "tile": { "type": "value", "col": 3, "row": 0, "w": 1, "h": 1 },
      "drill": { "type": "value" },
      "feedKey": "gas",
      "refreshMs": 30000,
      "maxFlowM3h": 2,
      "entities": {
        "flow": "sensor.home_gas_usage",
        "total": "sensor.gas_meter_gas_meter_direct"
      }
    },
    {
      "id": "climate",
      "kind": "climate",
      "title": "Thermostat",
      "icon": "temp",
      "tile": { "type": "value", "col": 3, "row": 1, "w": 1, "h": 1 },
      "drill": { "type": "value" },
      "feedKey": "climate",
      "refreshMs": 30000,
      "entities": {
        "thermostat": "climate.my_ecobee"
      }
    }
  ],
  "layouts": {
    "tablet": {
      "grid": { "cols": 4, "rows": 3 },
      "nightDim": { "start": "22:00", "end": "06:30", "brightness": 0.15 },
      "background": { "enabled": true, "intervalMs": 180000 },
      "modules": [
        {
          "id": "doors",
          "kind": "doors",
          "title": "Doors",
          "tile": { "type": "value", "col": 0, "row": 0, "w": 1, "h": 1 },
          "feedKey": "doors",
          "refreshMs": 5000,
          "openAlertSec": 300,
          "lookbackHours": 12,
          "entities": {
            "doors": [
              { "id": "front", "entity": "binary_sensor.front_doorcontact_contact", "label": "Front" },
              { "id": "back", "entity": "binary_sensor.back_doorcontact_contact", "label": "Back" }
            ]
          }
        },
        {
          "id": "laundry",
          "kind": "laundry",
          "title": "Laundry",
          "tile": { "type": "value", "col": 1, "row": 0, "w": 1, "h": 1 },
          "feedKey": "laundry",
          "refreshMs": 5000,
          "machines": [
            { "id": "washer", "label": "Washer", "color": "#00AAFF", "entities": { "power": "sensor.emporia_circuit_7_power" } },
            { "id": "dryer", "label": "Dryer", "color": "#FF6900", "entities": { "power": "sensor.emporia_circuit_8_power" } }
          ]
        },
        { "ref": "timeline", "title": "Activity", "tile": { "type": "agenda", "col": 3, "row": 0, "w": 1, "h": 3, "dropHeaders": true } },
        {
          "ref": "water", "runningSeverity": "normal", "tileStyle": "rate",
          "tile": { "type": "value", "col": 0, "row": 1, "w": 1, "h": 1 },
          "entities": {
            "hourly": "sensor.water_hourly_usage",
            "flow": "sensor.water_flow_lpm",
            "daily": "sensor.water_daily_usage",
            "cost_today": "sensor.water_cost_today",
            "monthly": "sensor.water_monthly_usage",
            "monthly_cost": "sensor.water_monthly_estimated_cost",
            "total": "sensor.water_meter_total",
            "stat_usage": "sensor.water_meter_total",
            "stat_cost": "sensor.water_meter_total_cost"
          }
        },
        {
          "ref": "energy", "tileStyle": "rate",
          "tile": { "type": "value", "col": 1, "row": 1, "w": 1, "h": 1 },
          "entities": {
            "power": "sensor.emporia_total_power",
            "daily_energy": "sensor.emporia_total_daily_energy_kwh",
            "cost": "sensor.electricity_daily_cost",
            "monthly": "sensor.electricity_monthly_usage",
            "monthly_cost": "sensor.electricity_monthly_estimated_cost",
            "stat_usage": "sensor.emporia_total_daily_energy_kwh",
            "stat_cost": "sensor.emporia_total_daily_energy_kwh_cost"
          }
        },
        {
          "ref": "climate",
          "tile": { "type": "value", "col": 2, "row": 2, "w": 1, "h": 1 },
          "entities": {
            "thermostat": "climate.my_ecobee",
            "indoor_temp": "sensor.my_ecobee_temperature",
            "outdoor_temp": "sensor.edmonton_weather_temperature"
          }
        },
        {
          "ref": "weather",
          "tile": { "type": "value", "col": 0, "row": 2, "w": 1, "h": 1 },
          "entities": {
            "forecast": "weather.edmonton_forecast",
            "indoor": "weather.my_ecobee",
            "outdoor_temp": "sensor.edmonton_weather_temperature",
            "sun": "sun.sun",
            "wind_chill": "sensor.edmonton_weather_wind_chill"
          }
        },
        {
          "ref": "gas", "tileStyle": "rate",
          "tile": { "type": "value", "col": 1, "row": 2, "w": 1, "h": 1 },
          "entities": {
            "flow": "sensor.gas_flow",
            "total": "sensor.gas_meter_total",
            "daily": "sensor.gas_daily_usage",
            "cost_today": "sensor.gas_cost_today",
            "monthly": "sensor.gas_monthly_usage",
            "monthly_cost": "sensor.gas_monthly_cost",
            "stat_usage": "sensor.gas_meter_gas_meter_direct",
            "stat_cost": "sensor.gas_meter_gas_meter_direct_cost"
          }
        },
        { "ref": "calendar", "tile": { "type": "agenda", "col": 2, "row": 0, "w": 1, "h": 2, "dropHeaders": false } }
      ]
    }
  }
}
